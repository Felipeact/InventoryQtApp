        <property name="styleSheet">
            <string notr="true">
QDialog {
    background-color: #050B14;
    color: white;
}
QLabel#dialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: white;
}
QLabel#fieldLabel, QLabel#sectionTitle {
    font-size: 13px;
    color: #e6eefb;
}
QLabel#sectionTitle {
    font-weight: 600;
    font-size: 14px;
}
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit {
    background: #0b1626;
    border: 1px solid #243751;
    border-radius: 8px;
    color: #e6eefb;
    padding: 9px 13px;
    min-height: 35px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 1px solid #2f80ed;
    background: #0e1b2f;
}
QWidget#fileUploadArea, QWidget#previewArea {
    background-color: #091426;
    border: 2px dashed #243751;
    border-radius: 10px;
}
QLabel#uploadPrompt {
    color: #94A3B8;
    font-size: 12px;
}
QLabel#fileName {
    color: #e6eefb;
    font-weight: 600;
}
QPushButton#browseButton, QPushButton#uploadReceiptButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #2563eb, stop:1 #1d4ed8);
    border: none;
    color: white;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 650;
}
QPushButton#browseButton:hover, QPushButton#uploadReceiptButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #3b82f6, stop:1 #2563eb);
}
QPushButton#cancelButton {
    background: #0b1626;
    border: 1px solid #263a55;
    color: #e6eefb;
    border-radius: 8px;
    padding: 10px 18px;
}
QPushButton#cancelButton:hover {
    background: #14253d;
    border-color: #2f80ed;
}
            </string>
