<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <class>UploadReceiptDialogClass</class>
    <widget class="QDialog" name="UploadReceiptDialogClass">
        <property name="geometry">
            <rect>
                <x>0</x>
                <y>0</y>
