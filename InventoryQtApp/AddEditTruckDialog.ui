				color: #3B82F6;
				font-size: 12px;
				}

				QWidget#formCard {
				background: qlineargradient(
				x1:0, y1:0,
				x2:1, y2:1,
				stop:0 #0B1626,
				stop:1 #091322
				);
				border: 1px solid #1B2A40;
				border-radius: 12px;
				}

				QLabel#sectionTitle {
				font-size: 16px;
				font-weight: 800;
				color: #FFFFFF;
				}

