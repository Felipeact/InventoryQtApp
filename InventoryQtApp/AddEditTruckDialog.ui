				color: #CBD5E1;
				font-size: 12px;
				font-weight: 600;
				}

				QLineEdit,
				QComboBox,
				QPlainTextEdit {
				background-color: #08111F;
				border: 1px solid #1E3350;
				border-radius: 8px;
				color: #FFFFFF;
				padding: 8px 12px;
				min-height: 34px;
				font-size: 12px;
				}

				QLineEdit:focus,
				QComboBox:focus,
				QPlainTextEdit:focus {
				border: 1px solid #2563EB;
				background-color: #0B1626;
				}

				QLineEdit::placeholder,
				QPlainTextEdit {
				color: #7F8DA3;
				}

				QComboBox::drop-down {
				border: none;
				width: 26px;
				}

				QPushButton#cancelButton {
				background-color: #08111F;
				border: 1px solid #1E3350;
				border-radius: 8px;
				color: #FFFFFF;
				min-height: 36px;
				font-weight: 700;
				}

				QPushButton#cancelButton:hover {
				background-color: #111C2D;
				border: 1px solid #2563EB;
				}

				QPushButton#saveButton {
				background-color: #2563EB;
				border: none;
				border-radius: 8px;
				color: #FFFFFF;
				min-height: 36px;
				font-weight: 800;
				}

				QPushButton#saveButton:hover {
				background-color: #1D4ED8;
				}
			</string>
