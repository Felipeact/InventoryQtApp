		<property name="windowTitle">
			<string>Use Truck Item</string>
		</property>

		<property name="styleSheet">
			<string notr="true">
				QDialog#UseTruckItemDialogClass {
				background-color: #050B14;
				color: #FFFFFF;
				font-family: "Segoe UI";
				}

				QLabel {
				background: transparent;
				color: white;
				}

				QLabel#dialogTitle {
				font-size: 24px;
				font-weight: 800;
				}

				QLabel#backLabel {
				color: #3B82F6;
				font-size: 12px;
				}

				QWidget#formCard,
				QWidget#quantityCard {
				background: qlineargradient(
				x1:0, y1:0,
				x2:1, y2:1,
				stop:0 #0B1626,
				stop:1 #091322
				);
				border: 1px solid #1B2A40;
				border-radius: 12px;
				}

				QLabel#sectionTitle {
				font-size: 16px;
				font-weight: 800;
				}

				QLabel#fieldLabel,
				QLabel#itemLabel,
				QLabel#quantityLabel,
				QLabel#notesLabel {
				color: #CBD5E1;
				font-size: 12px;
				font-weight: 600;
				}

				QLabel#currentQtyValue {
				color: #FFFFFF;
				font-size: 34px;
				font-weight: 800;
				}

				QLabel#currentQtyLabel {
				color: #94A3B8;
				font-size: 12px;
				}

				QComboBox,
				QSpinBox,
				QPlainTextEdit {
				background-color: #08111F;
				border: 1px solid #1E3350;
				border-radius: 8px;
				color: white;
				padding: 8px 12px;
				min-height: 36px;
				font-size: 12px;
				}

				QComboBox:focus,
				QSpinBox:focus,
				QPlainTextEdit:focus {
				border: 1px solid #2563EB;
				}

				QComboBox::drop-down {
				border: none;
				width: 26px;
				}

				QPlainTextEdit {
				min-height: 90px;
				}

				QSpinBox {
				font-size: 18px;
				font-weight: 800;
				}

				QSpinBox::up-button,
				QSpinBox::down-button {
				width: 0px;
				height: 0px;
				border: none;
				}

				QPushButton#minusButton,
				QPushButton#plusButton {
				background-color: #08111F;
				border: 1px solid #1E3350;
				border-radius: 8px;
				color: white;
				min-width: 44px;
				min-height: 40px;
				font-size: 20px;
				font-weight: 800;
				}

				QPushButton#minusButton:hover,
				QPushButton#plusButton:hover {
				border: 1px solid #2563EB;
				background-color: #111C2D;
				}

				QPushButton#cancelButton {
				background-color: #08111F;
				border: 1px solid #1E3350;
				border-radius: 8px;
				color: white;
				min-height: 38px;
				min-width: 120px;
				font-weight: 700;
				}

				QPushButton#cancelButton:hover {
				background-color: #111C2D;
				}

				QPushButton#useButton {
				background-color: #2563EB;
				border: none;
				border-radius: 8px;
				color: white;
				min-height: 38px;
				min-width: 130px;
				font-weight: 800;
				}

				QPushButton#useButton:hover {
				background-color: #1D4ED8;
				}
			</string>
		</property>

