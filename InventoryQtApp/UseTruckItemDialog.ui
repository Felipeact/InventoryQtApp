        <property name="windowTitle">
            <string>Use Item</string>
        </property>
        <property name="styleSheet">
            <string notr="true">
QDialog {
    background-color: #050B14;
    color: white;
}
QLabel#dialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: white;
}
QLabel#fieldLabel, QLabel#valueLabel {
    font-size: 13px;
    color: #e6eefb;
}
QLabel#valueLabel {
    font-weight: 600;
    color: white;
    font-size: 14px;
}
QLabel#quantityDisplay {
    font-size: 28px;
    font-weight: 700;
    color: #2563EB;
    text-align: center;
}
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit {
    background: #0b1626;
    border: 1px solid #243751;
    border-radius: 8px;
    color: #e6eefb;
    padding: 9px 13px;
    min-height: 35px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 1px solid #2f80ed;
    background: #0e1b2f;
}
QWidget#quantityCard {
    background-color: #091426;
    border: 1px solid #1A2A40;
    border-radius: 10px;
    padding: 12px;
}
QPushButton#decreaseButton, QPushButton#increaseButton {
    background-color: #0b1626;
    border: 1px solid #243751;
    color: white;
    border-radius: 6px;
    font-weight: 700;
    font-size: 16px;
    min-width: 40px;
    min-height: 40px;
}
QPushButton#decreaseButton:hover, QPushButton#increaseButton:hover {
    background-color: #14253d;
    border-color: #2f80ed;
}
QPushButton#useItemButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #2563eb, stop:1 #1d4ed8);
    border: none;
    color: white;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 650;
}
QPushButton#useItemButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #3b82f6, stop:1 #2563eb);
}
QPushButton#cancelButton {
    background: #0b1626;
    border: 1px solid #263a55;
    color: #e6eefb;
    border-radius: 8px;
    padding: 10px 18px;
}
QPushButton#cancelButton:hover {
    background: #14253d;
    border-color: #2f80ed;
}
            </string>
