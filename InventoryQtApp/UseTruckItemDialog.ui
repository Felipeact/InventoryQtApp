<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <class>UseTruckItemDialogClass</class>
    <widget class="QDialog" name="UseTruckItemDialogClass">
        <property name="geometry">
            <rect>
                <x>0</x>
                <y>0</y>
                <width>500</width>
                <height>450</height>
            </rect>
