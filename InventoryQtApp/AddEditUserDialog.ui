		<property name="styleSheet">
			<string notr="true">
				QDialog#AddEditUserDialogClass {
				background-color: #050B14;
				color: #FFFFFF;
				font-family: "Segoe UI";
				}

				QLabel {
				background: transparent;
				color: white;
				}

				QLabel#dialogTitle {
				font-size: 24px;
				font-weight: 800;
				}

				QLabel#subtitleLabel {
				color: #94A3B8;
				font-size: 12px;
				}

				QWidget#formCard {
				background: qlineargradient(
				x1:0, y1:0,
				x2:1, y2:1,
				stop:0 #0B1626,
				stop:1 #091322
				);
				border: 1px solid #1B2A40;
				border-radius: 12px;
				}

				QLabel#fieldLabel {
				color: #CBD5E1;
				font-size: 12px;
				font-weight: 600;
				}

				QLineEdit,
				QComboBox {
				background-color: #08111F;
				border: 1px solid #1E3350;
				border-radius: 8px;
				color: white;
				min-height: 36px;
				padding-left: 12px;
				font-size: 12px;
				}

				QLineEdit:focus,
				QComboBox:focus {
				border: 1px solid #2563EB;
				}

				QComboBox::drop-down {
				border: none;
				width: 24px;
				}

				QPushButton#cancelButton {
				background-color: #08111F;
				border: 1px solid #1E3350;
				border-radius: 8px;
				color: white;
				min-height: 38px;
				min-width: 110px;
				font-size: 12px;
				font-weight: 700;
				}

				QPushButton#cancelButton:hover {
				background-color: #111C2D;
				}

				QPushButton#saveButton {
				background-color: #2563EB;
				border: none;
				border-radius: 8px;
				color: white;
				min-height: 38px;
				min-width: 120px;
				font-size: 12px;
				font-weight: 800;
				}

				QPushButton#saveButton:hover {
				background-color: #1D4ED8;
				}
			</string>
		</property>

