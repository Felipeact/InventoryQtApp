QDialog {
    background-color: #050B14;
    color: white;
}
QLabel#dialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: white;
}
QLabel#sectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #e6eefb;
}
QLabel#fieldLabel {
    font-size: 13px;
    color: #e6eefb;
}
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit {
    background: #0b1626;
    border: 1px solid #243751;
    border-radius: 8px;
    color: #e6eefb;
    padding: 9px 13px;
    min-height: 35px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 1px solid #2f80ed;
    background: #0e1b2f;
}
QWidget#leftPanel, QWidget#rightPanel {
    background-color: transparent;
}
QWidget#itemsCard {
    background-color: #091426;
    border: 1px solid #1A2A40;
    border-radius: 10px;
}
QTableWidget {
    background-color: transparent;
    border: none;
    color: white;
    gridline-color: transparent;
}
QHeaderView::section {
    background-color: #0C1728;
    color: #94A3B8;
    border: none;
    border-bottom: 1px solid #1F2E45;
    padding-left: 10px;
    height: 34px;
    font-weight: 600;
    font-size: 11px;
}
QTableWidget::item {
    border-bottom: 1px solid #132238;
    padding-left: 10px;
    height: 36px;
}
QTableWidget::item:selected {
    background-color: #132238;
}
QPushButton#addItemButton, QPushButton#saveButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #2563eb, stop:1 #1d4ed8);
    border: none;
    color: white;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 650;
}
QPushButton#addItemButton:hover, QPushButton#saveButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #3b82f6, stop:1 #2563eb);
}
QPushButton#cancelButton, QPushButton#removeItemButton {
    background: #0b1626;
    border: 1px solid #263a55;
    color: #e6eefb;
    border-radius: 8px;
    padding: 8px 16px;
}
QPushButton#cancelButton:hover, QPushButton#removeItemButton:hover {
    background: #14253d;
    border-color: #2f80ed;
}
QPushButton#editItemButton {
    background: transparent;
    border: none;
    color: #2563EB;
    padding: 4px 8px;
}
QPushButton#editItemButton:hover {
    color: #3B82F6;
}
