<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
	<class>AssignTemplateDialogClass</class>

	<widget class="QDialog" name="AssignTemplateDialogClass">
		<property name="geometry">
			<rect>
				<x>0</x>
				<y>0</y>
				<width>760</width>
				<height>520</height>
			</rect>
		</property>

		<property name="windowTitle">
			<string>Assign Template</string>
		</property>

		<property name="styleSheet">
			<string notr="true">

				QDialog#AssignTemplateDialogClass {
				background-color: #050B14;
				color: #FFFFFF;
				font-family: "Segoe UI";
				}

				QLabel {
				background: transparent;
				color: #FFFFFF;
				}

				QLabel#dialogTitle {
				font-size: 24px;
				font-weight: 800;
				}

				QLabel#backLabel {
				color: #3B82F6;
				font-size: 12px;
				}

				QWidget#formCard {
				background: qlineargradient(
				x1:0, y1:0,
				x2:1, y2:1,
				stop:0 #0B1626,
				stop:1 #091322
				);
				border: 1px solid #1B2A40;
				border-radius: 12px;
				}

				QLabel#sectionTitle {
				font-size: 16px;
				font-weight: 800;
				color: #FFFFFF;
				}

				QLabel#fieldLabel {
				color: #CBD5E1;
				font-size: 12px;
				font-weight: 600;
				}

				QComboBox,
				QDateEdit,
				QPlainTextEdit {
				background-color: #08111F;
				border: 1px solid #1E3350;
				border-radius: 8px;
				color: #FFFFFF;
				padding: 8px 12px;
				min-height: 36px;
				font-size: 12px;
				}

				QComboBox:focus,
				QDateEdit:focus,
				QPlainTextEdit:focus {
				border: 1px solid #2563EB;
				}

				QComboBox::drop-down {
				border: none;
				width: 26px;
				}

				QPlainTextEdit {
				min-height: 110px;
				}

				QPushButton#cancelButton {
				background-color: #08111F;
				border: 1px solid #1E3350;
				border-radius: 8px;
				color: white;
				min-height: 38px;
				min-width: 120px;
				font-weight: 700;
				}

				QPushButton#cancelButton:hover {
				background-color: #111C2D;
				}

				QPushButton#assignButton {
				background-color: #2563EB;
				border: none;
				border-radius: 8px;
				color: white;
				min-height: 38px;
				min-width: 140px;
				font-weight: 800;
				}

				QPushButton#assignButton:hover {
				background-color: #1D4ED8;
				}

			</string>
		</property>

		<layout class="QVBoxLayout" name="rootLayout">

			<property name="leftMargin">
				<number>18</number>
			</property>

			<property name="topMargin">
				<number>18</number>
			</property>

			<property name="rightMargin">
				<number>18</number>
			</property>

			<property name="bottomMargin">
				<number>18</number>
			</property>

			<property name="spacing">
				<number>14</number>
			</property>

			<!-- TITLE -->

			<item>

				<layout class="QVBoxLayout" name="titleLayout">

					<property name="spacing">
						<number>4</number>
					</property>

					<item>

						<widget class="QLabel" name="dialogTitle">

							<property name="text">
								<string>Assign Template</string>
							</property>

						</widget>

					</item>

					<item>

						<widget class="QLabel" name="backLabel">

							<property name="text">
								<string>← Back to Assignments</string>
							</property>

						</widget>

					</item>

				</layout>

			</item>

			<!-- FORM CARD -->

			<item>

				<widget class="QWidget" name="formCard" native="true">

					<layout class="QVBoxLayout" name="formCardLayout">

						<property name="leftMargin">
							<number>18</number>
						</property>

						<property name="topMargin">
							<number>18</number>
						</property>

						<property name="rightMargin">
							<number>18</number>
						</property>

						<property name="bottomMargin">
							<number>18</number>
						</property>

						<property name="spacing">
							<number>16</number>
						</property>

						<!-- SECTION TITLE -->

						<item>

							<widget class="QLabel" name="sectionTitle">

								<property name="text">
									<string>Assignment Information</string>
								</property>

							</widget>

						</item>

						<!-- FORM -->

						<item>

							<layout class="QGridLayout" name="formGrid">

								<property name="horizontalSpacing">
									<number>18</number>
								</property>

								<property name="verticalSpacing">
									<number>14</number>
								</property>

								<!-- TRUCK -->

								<item row="0" column="0">

									<widget class="QLabel" name="truckLabel">

										<property name="text">
											<string>Select Truck *</string>
										</property>

									</widget>

								</item>

								<item row="1" column="0">

									<widget class="QComboBox" name="truckComboBox">

					
									</widget>

								</item>

								<!-- TEMPLATE -->

								<item row="0" column="1">

									<widget class="QLabel" name="templateLabel">

										<property name="text">
											<string>Select Template *</string>
										</property>

									</widget>

								</item>

								<item row="1" column="1">

									<widget class="QComboBox" name="templateComboBox">

									</widget>

								</item>

								<!-- TECHNICIAN -->

								<item row="2" column="0">

									<widget class="QLabel" name="technicianLabel">

										<property name="text">
											<string>Technician *</string>
										</property>

									</widget>

								</item>

								<item row="3" column="0">

									<widget class="QComboBox" name="technicianComboBox">
									</widget>

								</item>

								<!-- DATE -->

								<item row="2" column="1">

									<widget class="QLabel" name="dateLabel">

										<property name="text">
											<string>Assignment Date</string>
										</property>

									</widget>

								</item>

								<item row="3" column="1">

									<widget class="QDateEdit" name="assignmentDateEdit">

										<property name="calendarPopup">
											<bool>true</bool>
										</property>

									</widget>

								</item>

								<!-- NOTES -->

								<item row="4" column="0" colspan="2">

									<widget class="QLabel" name="notesLabel">

										<property name="text">
											<string>Notes</string>
										</property>

									</widget>

								</item>

								<item row="5" column="0" colspan="2">

									<widget class="QPlainTextEdit" name="notesInput">

										<property name="placeholderText">
											<string>Add notes about this assignment...</string>
										</property>

									</widget>

								</item>

							</layout>

						</item>

						<!-- BUTTONS -->

						<item>

							<layout class="QHBoxLayout" name="buttonLayout">

								<property name="spacing">
									<number>12</number>
								</property>

								<item>

									<spacer name="buttonSpacer">

										<property name="orientation">
											<enum>Qt::Horizontal</enum>
										</property>

									</spacer>

								</item>

								<item>

									<widget class="QPushButton" name="cancelButton">

										<property name="text">
											<string>Cancel</string>
										</property>

									</widget>

								</item>

								<item>

									<widget class="QPushButton" name="assignButton">

										<property name="text">
											<string>Assign Template</string>
										</property>

									</widget>

								</item>

							</layout>

						</item>

					</layout>

				</widget>

			</item>

		</layout>

	</widget>

	<resources/>
	<connections/>
</ui>