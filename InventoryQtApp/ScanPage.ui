		<property name="styleSheet">
			<string notr="true">
				QWidget#ScanPageClass {
				background-color: #050B14;
				color: #FFFFFF;
				font-family: "Segoe UI";
				}

				QLabel {
				background-color: transparent;
				color: #FFFFFF;
				}

				QWidget#pageCard {
				background: qlineargradient(
				x1:0, y1:0, x2:1, y2:1,
				stop:0 #0B1626,
				stop:1 #091322
				);
				border: 1px solid #263A57;
				border-radius: 12px;
				}

				QLabel#pageTitleLabel {
				font-size: 15px;
				font-weight: 800;
				color: #FFFFFF;
				}

				QLabel#breadcrumbLabel {
				color: #94A3B8;
				font-size: 11px;
				}

				QWidget#scanCard,
				QWidget#recentScansCard {
				background: qlineargradient(
				x1:0, y1:0, x2:1, y2:1,
				stop:0 #0D1828,
				stop:1 #091322
				);
				border: 1px solid #1E2F46;
				border-radius: 10px;
				}

				QLabel#titleLabel {
				font-size: 18px;
				font-weight: 800;
				color: #FFFFFF;
				}

				QLabel#subtitleLabel {
				color: #94A3B8;
				font-size: 11px;
				}

				QLabel#quantityLabel {
				color: #E5EEF8;
				font-size: 12px;
				font-weight: 700;
				}

				QLineEdit#barcodeInput {
				background-color: #0B1626;
				border: 1px solid #3B82F6;
				border-radius: 6px;
				color: #FFFFFF;
				padding: 0 12px;
				min-height: 42px;
				font-size: 13px;
				}

				QLineEdit#barcodeInput:focus {
				border: 1px solid #60A5FA;
				background-color: #0E1B2F;
				}

				QLineEdit#barcodeInput::placeholder {
				color: #8EA0B8;
				}

				QLabel#barcodeIconLabel {
				background-color: transparent;
				color: #FFFFFF;
				font-size: 20px;
				}

				QSpinBox#quantityInput {
				background-color: #0B1626;
				border: 1px solid #263A57;
				border-radius: 0px;
				color: #FFFFFF;
				min-height: 42px;
				font-size: 14px;
				}

				QSpinBox#quantityInput::up-button,
				QSpinBox#quantityInput::down-button {
				width: 0px;
				height: 0px;
				border: none;
				}

				QPushButton#minusButton,
				QPushButton#plusButton {
				background-color: #0B1626;
				border: 1px solid #263A57;
				color: #CBD5E1;
				font-size: 18px;
				font-weight: 600;
				}

				QPushButton#minusButton:hover,
				QPushButton#plusButton:hover {
				background-color: #172033;
				color: #FFFFFF;
				}

				QPushButton#minusButton {
				border-top-left-radius: 6px;
				border-bottom-left-radius: 6px;
				}

				QPushButton#plusButton {
				border-top-right-radius: 6px;
				border-bottom-right-radius: 6px;
				}

				QPushButton#submitButton {
				background-color: #16A34A;
				border: none;
				border-radius: 6px;
				color: #FFFFFF;
				min-height: 42px;
				font-size: 14px;
				font-weight: 800;
				}

				QPushButton#submitButton:hover {
				background-color: #22C55E;
				}

				QLabel#statusLabel {
				color: #FACC15;
				font-size: 12px;
				font-weight: 700;
				}

				QLabel#recentTitleLabel {
				color: #FFFFFF;
				font-size: 14px;
				font-weight: 800;
				}

				QLabel#recentCodeLabel,
				QLabel#recentNameLabel,
				QLabel#recentDateLabel {
				color: #CBD5E1;
				font-size: 11px;
				}

				QLabel#recentQtyLabel {
				color: #22C55E;
				font-size: 11px;
				font-weight: 800;
				}
			</string>
