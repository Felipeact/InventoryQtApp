    font-weight: bold;
}

QLabel#statusLabel {
    color: #9ca3af;
    font-style: italic;
}

QLineEdit#barcodeInput {
    background-color: #222222;
    border: 1px solid #2d2d2d;
    border-radius: 8px;
    padding: 8px 12px;
    color: #ffffff;
    selection-background-color: #0078d4;
}

QSpinBox#quantityInput {
    background-color: #222222;
    border: 1px solid #2d2d2d;
    border-radius: 8px;
    padding: 4px 8px;
    color: #ffffff;
}

QSpinBox::up-button#quantityInput {
    border: none;
    background-color: transparent;
}

QSpinBox::down-button#quantityInput {
    border: none;
    background-color: transparent;
}

QPushButton#submitButton {
    background-color: #0078d4;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 14px;
}

QPushButton#submitButton:hover {
    background-color: #106ebe;
}

QPushButton#submitButton:pressed {
    background-color: #0d5aa8;
}</string>
